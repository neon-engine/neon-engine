# Starts NeonEditor on the sandbox without a window, with a script that
# drives its tools, and looks at the exit code, what was logged, and what was
# saved. The scripts are next to this file and are copied into the folder of
# the test, which output:// stands for, since a script is named by a virtual
# path as every file is.

include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/scripts/run-application.cmake")

# run_script(<script> <argument>...): runs the editor with the script of that
# name from this folder, with any more arguments after it
function(run_script SCRIPT)
  file(COPY "${CMAKE_CURRENT_LIST_DIR}/${SCRIPT}" DESTINATION "${DIRECTORY}/shots")
  run(--headless-renderer --window-size 1280x800 --render-scale 1 --time-step 0.016667
          --output-dir shots --editor-script "output://${SCRIPT}" ${ARGN})
  set(EXIT_CODE "${EXIT_CODE}" PARENT_SCOPE)
  set(OUTPUT "${OUTPUT}" PARENT_SCOPE)
endfunction()

function(skip_without_vulkan)
  string(FIND "${OUTPUT}" "Failed to initialize Vulkan" NO_VULKAN)
  if (NOT NO_VULKAN EQUAL -1)
    message("SKIPPED: this machine cannot start the Vulkan renderer")
    message("${OUTPUT}")
    return()
  endif ()
endfunction()

if (CASE STREQUAL "view-log-switches-the-log")
  run_script(view-log.editor-script.yml)
  skip_without_vulkan()
  expect_exit_code(0)
  expect_no_output("[error]")
  expect_no_output("[critical]")
  expect_output("The tool interface is drawn with Dear ImGui")
  expect_output("without a window, at 1280 by 800 points")
  expect_output("A script of 9 steps drives the tools: View > Log switches the Log window off and on")
  expect_output("'menu View > Log' on line 7, is done")
  expect_output("'expect window Log hidden' on line 8, is done")
  expect_output("'expect window Log shown' on line 11, is done")
  expect_output("The script is done, all 9 steps of it")
  expect_output("The script is done, so the run ends")
  expect_image("shots/log-hidden.png")
  expect_image("shots/log-shown.png")
elseif (CASE STREQUAL "file-quit-ends-the-run")
  run_script(quit.editor-script.yml)
  skip_without_vulkan()
  expect_exit_code(0)
  expect_no_output("[error]")
  expect_output("Quit was chosen in the File menu")
  expect_output("'menu File > Quit' on line 3, is done")
elseif (CASE STREQUAL "a-failed-expectation-names-the-step")
  run_script(failing.editor-script.yml)
  skip_without_vulkan()
  expect_exit_code(1)
  expect_output("Step 1 of the script, 'expect window Hierarchy shown' on line 3, failed: the window 'Hierarchy' is not shown. Shown: 'Viewport', 'Log'")
  expect_output("The script failed, so the run ends with exit code 1")
  expect_no_file("shots/never.png")
elseif (CASE STREQUAL "a-script-that-cannot-be-read-stops-the-start")
  run_script(unreadable.editor-script.yml)
  skip_without_vulkan()
  expect_exit_code(1)
  expect_output("output://unreadable.editor-script.yml:3: 'press' is not a step. Known are: menu, click, type, key, pointer, drag, wait, screenshot, expect")
  expect_no_output("Rendered")
elseif (CASE STREQUAL "tools-are-drawn-for-a-screenshot")
  run(--headless-renderer --window-size 1280x800 --render-scale 1 --time-step 0.016667 --tools --frames 3
          --output-dir shots --screenshot output://tools.png)
  skip_without_vulkan()
  expect_exit_code(0)
  expect_no_output("[error]")
  expect_output("The tool interface is drawn with Dear ImGui")
  expect_output("Rendered 3 frames, stopping")
  expect_image("shots/tools.png")
else ()
  message(FATAL_ERROR "There is no case '${CASE}'")
endif ()
