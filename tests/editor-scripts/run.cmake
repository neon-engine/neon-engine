# Starts NeonEditor on the sandbox without a window, with a script that
# drives its tools, and looks at the exit code, what was logged, and what was
# saved. The scripts are next to this file and are copied into the folder of
# the test, which output:// stands for, since a script is named by a virtual
# path as every file is.

include("${CMAKE_CURRENT_LIST_DIR}/../../cmake/scripts/run-application.cmake")

# run_script_at(<size> <script> <argument>...): runs the editor with the
# script of that name from this folder, at that size, such as 1280x800, or at
# the size of the editor's own settings when the size is "own", with any more
# arguments after it
function(run_script_at SIZE SCRIPT)
  file(COPY "${CMAKE_CURRENT_LIST_DIR}/${SCRIPT}" DESTINATION "${DIRECTORY}/shots")
  set(SIZE_ARGUMENTS)
  if (NOT SIZE STREQUAL "own")
    set(SIZE_ARGUMENTS --window-size ${SIZE})
  endif ()
  run(--headless-renderer ${SIZE_ARGUMENTS} --render-scale 1 --time-step 0.016667
          --output-dir shots --editor-script "output://${SCRIPT}" ${ARGN})
  set(EXIT_CODE "${EXIT_CODE}" PARENT_SCOPE)
  set(OUTPUT "${OUTPUT}" PARENT_SCOPE)
endfunction()

# run_script(<script> <argument>...): run_script_at, at 1280 by 800 points
function(run_script SCRIPT)
  run_script_at(1280x800 ${SCRIPT} ${ARGN})
  set(EXIT_CODE "${EXIT_CODE}" PARENT_SCOPE)
  set(OUTPUT "${OUTPUT}" PARENT_SCOPE)
endfunction()

# expect_image_size(<path> <width> <height>): the PNG saved there, relative
# to the folder of the test, is that many pixels wide and high, as its
# header says
function(expect_image_size PATH WIDTH HEIGHT)
  expect_image("${PATH}")
  file(READ "${DIRECTORY}/${PATH}" HEADER OFFSET 16 LIMIT 8 HEX)
  string(SUBSTRING "${HEADER}" 0 8 WIDTH_HEX)
  string(SUBSTRING "${HEADER}" 8 8 HEIGHT_HEX)
  math(EXPR SAVED_WIDTH "0x${WIDTH_HEX}")
  math(EXPR SAVED_HEIGHT "0x${HEIGHT_HEX}")
  if (NOT SAVED_WIDTH EQUAL WIDTH OR NOT SAVED_HEIGHT EQUAL HEIGHT)
    fail("Expected ${PATH} to be ${WIDTH} by ${HEIGHT}, it is ${SAVED_WIDTH} by ${SAVED_HEIGHT}")
  endif ()
endfunction()

# expect_settings(<line>...): the editor's settings file holds every line
function(expect_settings)
  file(READ "${EDITOR_DIRECTORY}/editor-settings.yml" SETTINGS)
  foreach (LINE IN LISTS ARGN)
    string(FIND "${SETTINGS}" "${LINE}" FOUND)
    if (FOUND EQUAL -1)
      fail("Expected editor-settings.yml to hold '${LINE}', it holds:\n${SETTINGS}")
    endif ()
  endforeach ()
endfunction()

function(skip_without_vulkan)
  string(FIND "${OUTPUT}" "Failed to initialize Vulkan" NO_VULKAN)
  if (NOT NO_VULKAN EQUAL -1)
    message("SKIPPED: this machine cannot start the Vulkan renderer")
    message("${OUTPUT}")
    return()
  endif ()
endfunction()

# the folder the log says editor:// is, into EDITOR_DIRECTORY, and the one
# user:// is, into USER_DIRECTORY
function(find_folders)
  string(REGEX MATCH "editor:// is ([^\n\r]+)" MATCHED "${OUTPUT}")
  if (NOT MATCHED)
    fail("Expected the log to say where editor:// is")
  endif ()
  set(EDITOR_DIRECTORY "${CMAKE_MATCH_1}" PARENT_SCOPE)
  string(REGEX MATCH "user:// is ([^\n\r]+)" MATCHED "${OUTPUT}")
  if (NOT MATCHED)
    fail("Expected the log to say where user:// is")
  endif ()
  set(USER_DIRECTORY "${CMAKE_MATCH_1}" PARENT_SCOPE)
endfunction()

if (CASE STREQUAL "view-log-switches-the-log")
  run_script(view-log.editor-script.yml)
  skip_without_vulkan()
  expect_exit_code(0)
  expect_no_output("[error]")
  expect_no_output("[critical]")
  expect_output("The tool interface is drawn with Dear ImGui")
  expect_output("without a window, at 1280 by 800 points")
  expect_output("A script of 13 steps drives the tools: The editor opens with the viewport alone, and View > Log shows and hides the Log")
  expect_output("'expect window Log hidden' on line 7, is done")
  expect_output("'menu View > Log' on line 9, is done")
  expect_output("'expect window Log shown' on line 10, is done")
  expect_output("'click Log' on line 16, is done")
  expect_output("'expect window Log hidden' on line 17, is done")
  expect_output("The script is done, all 13 steps of it")
  expect_output("The script is done, so the run ends")
  expect_image("shots/viewport-alone.png")
  expect_image("shots/log-shown.png")
  expect_image("shots/view-menu-marked.png")
  expect_image("shots/log-hidden.png")
elseif (CASE STREQUAL "the-shortcut-switches-the-log")
  run_script(shortcut-log.editor-script.yml)
  skip_without_vulkan()
  expect_exit_code(0)
  expect_no_output("[error]")
  expect_output("'key Shortcut+L' on line 6, is done")
  expect_output("'expect window Log shown' on line 7, is done")
  expect_output("'key Shortcut+L' on line 8, is done")
  expect_output("'expect window Log hidden' on line 9, is done")
  expect_output("The script is done, all 5 steps of it")
elseif (CASE STREQUAL "the-log-comes-back-where-it-was")
  run_script(log-returns.editor-script.yml)
  skip_without_vulkan()
  expect_exit_code(0)
  expect_no_output("[error]")
  expect_output("'drag from 36,614 to 700,300' on line 10, is done")
  expect_output("The script is done, all 11 steps of it")
  expect_image("shots/log-moved.png")
  expect_image("shots/log-back.png")
elseif (CASE STREQUAL "a-mistake-in-the-settings-is-in-the-log")
  # the first run places the folder, a file with a mistake goes in, the
  # second run shows the Log and reads the mistake off it, with its line;
  # the errors are in the exit code, as every error of a run is
  run_script(show-log.editor-script.yml)
  skip_without_vulkan()
  expect_exit_code(0)
  find_folders()
  file(WRITE "${EDITOR_DIRECTORY}/editor-settings.yml" "version: 1\nwindow:\n  width: 1234\n  colour: red\n")

  run_script(mistake-in-log.editor-script.yml)
  expect_exit_code(1)
  expect_output("editor://editor-settings.yml:4: ")
  expect_output("'expect text 'editor://editor-settings.yml:4: '' on line 8, is done")
  expect_output("'expect text 'editor://editor-settings.yml is refused'' on line 9, is done")
  expect_output("The script is done, all 6 steps of it")
  expect_output("editor://editor-settings.yml was refused when it was read, and is not written back")
  expect_image("shots/mistake.png")
  file(READ "${EDITOR_DIRECTORY}/editor-settings.yml" KEPT)
  if (NOT KEPT STREQUAL "version: 1\nwindow:\n  width: 1234\n  colour: red\n")
    fail("Expected the refused file to be left as it was, it holds:\n${KEPT}")
  endif ()
elseif (CASE STREQUAL "the-log-and-the-window-survive-a-restart")
  # the first run, at a size of its own, shows the Log, floats it, and ends;
  # the second, with no size given, has the size the first left and the Log
  # shown floating where it was, and the editor's folder holds both
  run_script_at(1000x640 float-log.editor-script.yml)
  skip_without_vulkan()
  expect_exit_code(0)
  expect_no_output("[error]")
  expect_output("There is no editor://editor-settings.yml yet, the editor starts with its defaults")
  expect_output("There is no editor://layout.ini yet, the windows take their first places")
  expect_output("The editor's settings were written to editor://editor-settings.yml")
  expect_output("The layout of the windows was written to editor://layout.ini")
  expect_output("'drag from 36,494 to 500,200' on line 9, is done")
  expect_image_size("shots/left-floating.png" 1000 640)
  find_folders()
  expect_settings("width: 1000" "height: 640" "mode: windowed" "- Log")
  if (NOT EXISTS "${EDITOR_DIRECTORY}/layout.ini")
    fail("Expected ${EDITOR_DIRECTORY}/layout.ini")
  endif ()

  # the project's own folder got nothing of the editor's: the log alone
  file(GLOB_RECURSE USER_FILES RELATIVE "${USER_DIRECTORY}" "${USER_DIRECTORY}/*")
  foreach (USER_FILE IN LISTS USER_FILES)
    if (NOT USER_FILE MATCHES "\\.log$")
      fail("Expected nothing but the log in ${USER_DIRECTORY}, found ${USER_FILE}")
    endif ()
  endforeach ()

  run_script_at(own log-restored.editor-script.yml)
  expect_exit_code(0)
  expect_no_output("[error]")
  expect_output("The editor's settings were read from editor://editor-settings.yml: a window of 1000 by 640 points, windowed")
  expect_output("The layout of the windows was read from editor://layout.ini")
  expect_output("without a window, at 1000 by 640 points")
  expect_output("'expect window Log shown' on line 6, is done")
  expect_output("The script is done, all 4 steps of it")
  expect_image_size("shots/restored.png" 1000 640)
elseif (CASE STREQUAL "the-window-size-of-the-command-line-wins")
  # the first run leaves a size in the editor's settings; the second names
  # another on the command line, runs at it, and leaves the window at it
  run_script_at(1000x640 show-log.editor-script.yml)
  skip_without_vulkan()
  expect_exit_code(0)
  find_folders()
  expect_settings("width: 1000" "height: 640")

  run_script_at(1280x720 log-restored.editor-script.yml)
  expect_exit_code(0)
  expect_no_output("[error]")
  expect_output("The editor's settings were read from editor://editor-settings.yml: a window of 1000 by 640 points, windowed")
  expect_output("without a window, at 1280 by 720 points")
  expect_image_size("shots/restored.png" 1280 720)
  expect_settings("width: 1280" "height: 720" "- Log")
elseif (CASE STREQUAL "file-quit-ends-the-run")
  run_script(quit.editor-script.yml)
  skip_without_vulkan()
  expect_exit_code(0)
  expect_no_output("[error]")
  expect_output("Quit was chosen in the File menu")
  expect_output("'menu File > Quit' on line 3, is done")
elseif (CASE STREQUAL "a-failed-expectation-names-the-step")
  run_script(failing.editor-script.yml)
  skip_without_vulkan()
  expect_exit_code(1)
  expect_output("Step 1 of the script, 'expect window Hierarchy shown' on line 3, failed: the window 'Hierarchy' is not shown. Shown: 'Viewport'")
  expect_output("The script failed, so the run ends with exit code 1")
  expect_no_file("shots/never.png")
elseif (CASE STREQUAL "a-script-that-cannot-be-read-stops-the-start")
  run_script(unreadable.editor-script.yml)
  skip_without_vulkan()
  expect_exit_code(1)
  expect_output("output://unreadable.editor-script.yml:3: 'press' is not a step. Known are: menu, click, type, key, pointer, drag, wait, screenshot, expect")
  expect_no_output("Rendered")
elseif (CASE STREQUAL "tools-are-drawn-for-a-screenshot")
  run(--headless-renderer --window-size 1280x800 --render-scale 1 --time-step 0.016667 --tools --frames 3
          --output-dir shots --screenshot output://tools.png)
  skip_without_vulkan()
  expect_exit_code(0)
  expect_no_output("[error]")
  expect_output("The tool interface is drawn with Dear ImGui")
  expect_output("Rendered 3 frames, stopping")
  expect_image("shots/tools.png")
else ()
  message(FATAL_ERROR "There is no case '${CASE}'")
endif ()
