# Build directories
cmake-build-*
bin/
build/


# Runtime log output
logs/

# The settings of VS Code are shared, since they hold the limits of the C++
# extension that keep the machine stable. What is personal goes in the
# user's own settings, not the workspace's.

# Working trees for branches that are worked on side by side
worktrees/

# What macOS leaves in folders: Finder's settings, and the custom icon of a
# folder, a file named Icon that downloaded sound packs come with
.DS_Store
**/sounds/**/Icon*
